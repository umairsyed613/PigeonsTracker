@page "/CreatePublicTournament"
@inject IPublicTournamentService PublicTournamentService
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<Language> Localizer
@inject AppState AppState

<PagesBase>
    <div class="d-flex flex-column gap-3 mt-3 w-100 animate__animated animate__fadeInRight @(AppState.IsLanguageUrdu() ? "rtl" : "")">
        <MyPageTitle Text='@($"{Localizer["CreateTournament"]} (Public)")'></MyPageTitle>

        @* ── Tournament basics ──────────────────────────────────────────── *@
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Tournament info</MudText>
            <MudTextField Label="@Localizer["TournamentName"]"
                          @bind-Value="_tournament.Name"
                          Variant="Variant.Outlined"
                          FullWidth="true"
                          Required="true"
                          Class="mb-3" />
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="@Localizer["TournamentStartDate"]"
                                   Editable="true"
                                   @bind-Date="_startDate"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="@Localizer["TournamentEndDate"]"
                                   Editable="true"
                                   @bind-Date="_endDate"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField InputType="InputType.Time"
                                  Label="@Localizer["FlyingStartTime"]"
                                  @bind-Value="_flyingStartTime"
                                  Format="HH:mm:ss"
                                  Variant="Variant.Outlined"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField InputType="InputType.Time"
                                  Label="Flying end time"
                                  @bind-Value="_flyingEndTime"
                                  Format="HH:mm:ss"
                                  Variant="Variant.Outlined"
                                  Required="true" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ── Bird configuration (global for all lofts) ─────────────────── *@
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Bird configuration <MudText Typo="Typo.caption" Inline="true" Class="mud-text-secondary">(applies to all lofts)</MudText></MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudNumericField Label="@Localizer["TotalBirdsCount"]"
                                     @bind-Value="_globalBirdCount"
                                     Min="1"
                                     Max="500"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6" Class="d-flex align-center">
                    <MudSwitch @bind-Value="_globalHasBabyBird" Color="Color.Primary" Label="Baby pigeon" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="_tournament.CanManageLoftRecords" Color="Color.Secondary" Label="Allow loft owners to update records with a code" />
                </MudItem>
            </MudGrid>
        </MudPaper>

        @* ── Lofts ─────────────────────────────────────────────────────── *@
        <MudPaper Class="pa-3" Elevation="1">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Lofts</MudText>
            <div class="d-flex gap-2 align-end">
                <MudTextField Label="Loft name"
                              @bind-Value="_newLoftName"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              OnKeyDown="@(async e => { if (e.Key == "Enter") AddLoft(); })"
                              FullWidth="true" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AddLoft"
                           Style="min-width:90px;height:56px;">
                    Add
                </MudButton>
            </div>

            @if (_tournament.Lofts.Count > 0)
            {
                <div class="d-flex flex-wrap gap-2 mt-3">
                    @foreach (var loft in _tournament.Lofts)
                    {
                        <MudChip T="string"
                                 Color="Color.Primary"
                                 Variant="Variant.Outlined"
                                 OnClose="() => RemoveLoft(loft.LoftId)"
                                 CloseIcon="@Icons.Material.Filled.Close">
                            @loft.LoftName
                        </MudChip>
                    }
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">No lofts added yet.</MudText>
            }
        </MudPaper>

        @* ── Submit ─────────────────────────────────────────────────────── *@
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.EmojiEvents"
                   OnClick="CreateTournament"
                   Disabled="@_isSaving">
            @(_isSaving ? "Creating..." : "Create Public Tournament")
        </MudButton>

        @if (_createdTournament is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mt-1">
                <div><strong>Manager code:</strong> @_createdTournament.ManagerCode</div>
                <div><strong>Recovery key:</strong> @_createdTournament.ManagerRecoveryKey</div>
                <div class="mt-1 mud-text-secondary">Saved on this device as manager credentials.</div>
            </MudAlert>
        }
    </div>
</PagesBase>

@code {
    private PublicTournament _tournament = new()
    {
        Id = IdGenerator.GetNewId(),
        CreatedAt = DateTime.Now,
        Lofts = [],
        DayRecords = []
    };

    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today.AddDays(7);
    private DateTime _flyingStartTime = new(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 6, 0, 0);
    private DateTime _flyingEndTime = new(DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day, 18, 0, 0);

    private int _globalBirdCount = 7;
    private bool _globalHasBabyBird;

    private string _newLoftName = string.Empty;

    private bool _isSaving;
    private PublicTournament _createdTournament;

    private void AddLoft()
    {
        if (string.IsNullOrWhiteSpace(_newLoftName))
        {
            Snackbar.Add("Loft name is required", Severity.Warning);
            return;
        }

        if (_tournament.Lofts.Any(a => a.LoftName.Equals(_newLoftName.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            Snackbar.Add("Loft name already exists", Severity.Warning);
            return;
        }

        _tournament.Lofts.Add(new PublicTournamentLoft
        {
            LoftId = IdGenerator.GetNewId(),
            LoftName = _newLoftName.Trim(),
            BirdCount = _globalBirdCount,
            HasBabyPigeon = _globalHasBabyBird,
            CreatedAt = DateTime.Now
        });

        _newLoftName = string.Empty;
    }

    private void RemoveLoft(string loftId)
    {
        var found = _tournament.Lofts.FirstOrDefault(f => f.LoftId == loftId);
        if (found != null)
            _tournament.Lofts.Remove(found);
    }

    private async Task CreateTournament()
    {
        if (string.IsNullOrWhiteSpace(_tournament.Name))
        {
            Snackbar.Add(Localizer["HelpTournamentName"], Severity.Warning);
            return;
        }

        if (_tournament.Lofts.Count == 0)
        {
            Snackbar.Add("Add at least one loft", Severity.Warning);
            return;
        }

        if (!_startDate.HasValue || !_endDate.HasValue)
        {
            Snackbar.Add("Select start and end dates", Severity.Warning);
            return;
        }

        if (_endDate.Value.Date < _startDate.Value.Date)
        {
            Snackbar.Add("End date must be after start date", Severity.Warning);
            return;
        }

        if (_flyingEndTime.TimeOfDay <= _flyingStartTime.TimeOfDay)
        {
            Snackbar.Add("Flying end time must be after flying start time", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            _tournament.StartsFrom = _startDate.Value.Date;
            _tournament.EndTo = _endDate.Value.Date;
            _tournament.FlyingStartTime = new TimeSpan(_flyingStartTime.Hour, _flyingStartTime.Minute, _flyingStartTime.Second);
            _tournament.FlyingEndTime = new TimeSpan(_flyingEndTime.Hour, _flyingEndTime.Minute, _flyingEndTime.Second);

            _createdTournament = await PublicTournamentService.CreatePublicTournament(_tournament);
            await PublicTournamentService.StoreManagerCredentials(_createdTournament.Id, _createdTournament.ManagerCode, _createdTournament.ManagerRecoveryKey);

            Snackbar.Add("Public tournament created", Severity.Success);
            NavigationManager.NavigateTo($"/ViewPublicTournament/{_createdTournament.Id}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Create failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }
}

