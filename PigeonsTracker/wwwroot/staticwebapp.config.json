{
  "platform": {
    "apiRuntime": "dotnet-isolated:9.0"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/_framework/*",
      "/css/*"
    ]
  },
  "routes": [
    {
      "route": "/service-worker.js",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/service-worker.published.js",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/service-worker-assets.js",
      "headers": { "cache-control": "no-cache" }
    }
  ]
}